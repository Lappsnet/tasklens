# Server-only. Never import from client bundles.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
MODEL_FALLBACK_ID=muse-spark-1.2
ASR_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
STORAGE_BUCKET=media

# Stripe (secondary adapter, US merchants only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal (primary escrow provider, Orders API v2 AUTHORIZE)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PLATFORM_FEE_PCT=10

# Demo accounts for production "Try as …" login (server-side only)
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_PRO_EMAIL=
DEMO_PRO_PASSWORD=

# Maps / misc
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# Android TWA handshake (Play app-signing SHA-256, comma-separated; set after
# Play Console generates the signing key, then redeploy so assetlinks serves it)
ASSETLINKS_SHA256_FINGERPRINTS=
